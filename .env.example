# Engendré par `pwa-env sync` depuis config/env.manifest.json.
# App : mister-cim10
# Ne pas éditer à la main : modifier le manifeste, puis relancer sync --write.

# Clé projet PostHog (nuage EU)
# Repli : absent : pas de mesure ni bandeau
VITE_POSTHOG_KEY=

# DSN Sentry
# Repli : absent : no-op
VITE_SENTRY_DSN=

# Environnement Sentry
VITE_SENTRY_ENVIRONMENT=

# Langue WHO
VITE_WHO_LANG=

# Proxy API WHO
VITE_WHO_PROXY_URL=

# Release WHO
VITE_WHO_RELEASE_ID=
